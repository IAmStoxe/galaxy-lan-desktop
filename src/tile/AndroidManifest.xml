<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="org.galaxylan.desktop"
    android:versionCode="1" android:versionName="0.1.0">
    <uses-sdk android:minSdkVersion="30" android:targetSdkVersion="34"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"/>
    <application android:label="Galaxy LAN Desktop" android:allowBackup="false" android:extractNativeLibs="true" android:icon="@drawable/desktop" android:theme="@android:style/Theme.Material.NoActionBar">
        <activity android:name=".DesktopActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <receiver android:name=".PairNotification" android:exported="false"/>
        <receiver android:name=".PairController" android:exported="true" android:permission="android.permission.DUMP"/>
        <service android:name=".BrowserTile" android:label="DeX Browser" android:icon="@drawable/desktop"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE" android:exported="true">
            <intent-filter><action android:name="android.service.quicksettings.action.QS_TILE"/></intent-filter>
        </service>
    </application>
</manifest>
